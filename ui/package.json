{
  "name": "picket-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Picket core web UI (core.md \u00a712), embedded into picket-core from ui/dist.",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-native/bin/tsc -b && vite build",
    "lint": "eslint --max-warnings 0 . && node node_modules/typescript-native/bin/tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
