# UniFi's legacy (pre-zone) firewall: no UBIOS_FORWARD_IN_USER zone dispatch.
# Expect: no jump for any interface; each protected interface reports fw_layout_unknown.
# Written from the spec (not recorded) as `iptables -S` (filter table).
-P INPUT ACCEPT
-P FORWARD ACCEPT
-P OUTPUT ACCEPT
-N UBIOS_FORWARD_JUMP
-N UBIOS_FORWARD_USER_HOOK
-N UBIOS_INPUT_JUMP
-N UBIOS_INPUT_USER_HOOK
-N UBIOS_LAN_IN_USER
-N UBIOS_WAN_IN_USER
-A INPUT -j UBIOS_INPUT_JUMP
-A FORWARD -j UBIOS_FORWARD_JUMP
-A UBIOS_FORWARD_JUMP -j UBIOS_FORWARD_USER_HOOK
-A UBIOS_FORWARD_JUMP -i br0 -j UBIOS_LAN_IN_USER
-A UBIOS_FORWARD_JUMP -i br10 -j UBIOS_LAN_IN_USER
-A UBIOS_FORWARD_JUMP -i eth4 -j UBIOS_WAN_IN_USER
-A UBIOS_INPUT_JUMP -j UBIOS_INPUT_USER_HOOK
-A UBIOS_LAN_IN_USER -m comment --comment "00000001095216663481" -j RETURN
-A UBIOS_WAN_IN_USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A UBIOS_WAN_IN_USER -j DROP
