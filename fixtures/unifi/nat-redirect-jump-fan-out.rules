-A UBIOS_FANOUT_12 -p udp -m udp --dport 5353 -j RETURN
-A UBIOS_PREROUTING_JUMP -j UBIOS_DNAT_USER
-A UBIOS_POSTROUTING_JUMP -o eth4 -m comment --comment "UBIOS masquerade" -j MASQUERADE
-A UBIOS_DNAT_USER -i br0 -p udp -m udp --dport 53 -m comment --comment "NAT_POLICY DNS to Picket" -j DNAT --to-destination 192.0.2.1:5335
