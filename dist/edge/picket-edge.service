# Written by picket-edge-update (edge-unifi.md §2); `picket-edge-update units` prints this text.
# The next install or update overwrites edits: use a drop-in instead.
[Unit]
Description=Picket DNS filtering edge
Wants=picket-accounts.service picket-edge-helper.service
After=picket-accounts.service picket-edge-helper.service network.target
RequiresMountsFor={{INSTALL_DIR}} {{DATA_DIR}}
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart={{INSTALL_DIR}}/bin/current/picket-edge run --config {{CONFIG_FILE}} --data-dir {{DATA_DIR}}
User=picket
Group=picket
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=picket
RuntimeDirectoryMode=0770
ReadWritePaths={{DATA_DIR}}
{{SSD_READ_WRITE}}
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallFilter=@system-service
LimitNOFILE=65536
MemoryMax=768M
Environment=MALLOC_ARENA_MAX=4
WatchdogSec=30
Restart=always
RestartSec=1
{{EDGE_PLATFORM}}

[Install]
WantedBy=multi-user.target
