# Creates the picket-core instance on the first start of a fresh install (core.md §13): runs
# `picket-core init` only while the data directory has no marker. init's own rules keep it off a
# directory that holds anything else. The first admin password goes to
# /var/lib/picket-core/initial-password (0600), not to the journal (StandardOutput=null).
[Unit]
Description=Create the picket-core instance on first start
Before=picket-core.service
# Roughly right local time where the platform provides it; init never waits for network time
# (docs/clocks-and-lan-ca.md), so no time-sync.target here.
After=time-set.target
ConditionPathExists=!/var/lib/picket-core/.picket-core-instance

[Service]
Type=oneshot
User=picket-core
Group=picket-core
ExecStart=/usr/bin/picket-core init --data-dir /var/lib/picket-core
StandardOutput=null
Environment=MALLOC_ARENA_MAX=2
Environment=SQLITE_TMPDIR=/var/lib/picket-core/tmp
RestartPreventExitStatus=78
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/picket-core
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
